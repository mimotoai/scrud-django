{
  "name": "studio:push-after",
  "engine": "jinja2",
  "mode": "view",
  "template": "{%- set where = value.get(\"endpoints\") -%}\n{%- if where and where.get(\"live_preview\") %}\n<section class=\"studio-push-page-after\" data-studio-push-after data-studio-source=\"{{ value.source }}\" data-studio-target=\"{{ value.target }}\" aria-label=\"Preview after push\">\n<h2 class=\"studio-push-page-after-title\">Preview after push</h2>\n<div class=\"studio-push-page-after-controls\" data-studio-push-after-controls>\n<div class=\"studio-types\" data-studio-types>{{ embed(api_url(\"ui-type-catalog\", \"all\"), [\"studio\", \"studio-types\"]) }}</div>\n<button type=\"button\" class=\"studio-push-page-after-show\" data-studio-push-after-show>Preview after push</button>\n</div>\n<p class=\"studio-hint\" data-studio-push-after-note role=\"status\">Choose a type to preview {{ value.target }} after this push.</p>\n<template data-studio-push-after-form><form class=\"studio-preview-form\" data-studio-preview-form method=\"post\" action=\"{{ where.live_preview }}\" target=\"studio-push-after-preview\" hidden>\n<input type=\"hidden\" name=\"csrfmiddlewaretoken\" value=\"\">\n<input type=\"hidden\" name=\"request\" value=\"\">\n</form></template>\n<iframe name=\"studio-push-after-preview\" class=\"studio-preview\" sandbox=\"allow-scripts\" title=\"Preview of {{ value.target }} after the push\"></iframe>\n</section>\n{%- endif %}\n"
}
