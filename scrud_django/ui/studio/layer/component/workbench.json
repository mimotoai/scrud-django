{
  "name": "studio:workbench",
  "engine": "jinja2",
  "mode": "view",
  "template": "{%- set published = value.name == \"main\" or value.get(\"prefix\") -%}\n{%- set items_path = api_url(\"ui-branch-items\", value.name) -%}\n{%- set status_path = api_url(\"ui-branch-status\", value.name) -%}\n{%- set types_path = api_url(\"ui-type-catalog\", \"all\") -%}\n<div class=\"studio-workbench\" data-studio-workbench data-studio-branch=\"{{ value.name }}\" data-studio-published=\"{{ 'true' if published else 'false' }}\">\n<header class=\"studio-topbar\">\n<h1 class=\"studio-title\">{{ value.name }}{% if published %} <span class=\"studio-badge\">published</span>{% endif %}</h1>\n<div class=\"studio-toggles\" role=\"group\" aria-label=\"Panes\">\n<button type=\"button\" class=\"studio-toggle\" data-studio-toggle=\"items\" aria-pressed=\"true\">Items</button>\n<button type=\"button\" class=\"studio-toggle\" data-studio-toggle=\"editor\" aria-pressed=\"true\">Editor</button>\n<button type=\"button\" class=\"studio-toggle\" data-studio-toggle=\"preview\" aria-pressed=\"true\" disabled title=\"The preview can't be hidden\">Preview</button>\n</div>\n</header>\n<div class=\"studio-notice\" data-studio-notice role=\"alert\" hidden></div>\n<div class=\"studio-panes\">\n<section class=\"studio-pane\" data-studio-pane=\"items\" aria-label=\"Items\">\n<h2 class=\"studio-pane-title\">Items</h2>\n<div class=\"studio-pane-body\" data-studio-embed=\"items\" data-studio-src=\"{{ in_mount(items_path) }}\" data-studio-scope=\"studio studio-items\">{{ embed(items_path, [\"studio\", \"studio-items\"]) }}</div>\n</section>\n<section class=\"studio-pane\" data-studio-pane=\"editor\" aria-label=\"Editor\">\n<h2 class=\"studio-pane-title\">Editor</h2>\n<div class=\"studio-editor-head\" data-studio-editor-head hidden></div>\n<div class=\"studio-pane-body\" data-studio-editor><p class=\"studio-hint\">Open an item to edit it.</p></div>\n<div class=\"studio-draft-errors\" data-studio-draft-errors role=\"status\" hidden></div>\n</section>\n<section class=\"studio-pane\" data-studio-pane=\"preview\" aria-label=\"Preview\">\n<h2 class=\"studio-pane-title\">Preview</h2>\n<div class=\"studio-pane-body\">\n<div class=\"studio-preview-controls\" data-studio-preview-controls>\n<div class=\"studio-types\" data-studio-types>{{ embed(types_path, [\"studio\", \"studio-types\"]) }}</div>\n<label class=\"studio-control\">Mode <select data-studio-control=\"mode\"><option value=\"view\">view</option><option value=\"edit\">edit</option></select></label>\n<label class=\"studio-control\">Data context <input type=\"text\" data-studio-control=\"context\" placeholder=\"none\" spellcheck=\"false\"></label>\n<label class=\"studio-control\">Scope <input type=\"text\" data-studio-control=\"scope\" placeholder=\"none\" spellcheck=\"false\"></label>\n<label class=\"studio-control\">Instance <input type=\"text\" data-studio-control=\"instance\" placeholder=\"the sample\" spellcheck=\"false\"></label>\n<label class=\"studio-control\"><input type=\"checkbox\" data-studio-control=\"pinned\"> Pinned at the branching point</label>\n</div>\n<form class=\"studio-preview-form\" data-studio-preview-form method=\"post\" target=\"studio-preview\" hidden>\n<input type=\"hidden\" name=\"csrfmiddlewaretoken\" value=\"\">\n<input type=\"hidden\" name=\"request\" value=\"\">\n</form>\n<iframe name=\"studio-preview\" class=\"studio-preview\" sandbox=\"allow-scripts\" title=\"Preview of {{ value.name }}\"></iframe>\n<section class=\"studio-inspector\" data-studio-inspector aria-label=\"Inspector\">\n<h3 class=\"studio-inspector-title\">Inspector</h3>\n<div class=\"studio-explain\" data-studio-explain aria-live=\"polite\"><p class=\"studio-hint\">Click a part of the preview to inspect it.</p></div>\n{%- if not published %}\n<div class=\"studio-new-rule\" data-studio-new-rule hidden></div>\n{%- endif %}\n</section>\n</div>\n</section>\n</div>\n<footer class=\"studio-strip\" data-studio-embed=\"status\" data-studio-src=\"{{ in_mount(status_path) }}\" data-studio-scope=\"studio studio-status\">{{ embed(status_path, [\"studio\", \"studio-status\"]) }}</footer>\n</div>\n"
}
